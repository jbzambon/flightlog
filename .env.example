SITE_TITLE=Flight Log
# Optional one-line note under the flight list
SITE_FOOTER=
# Footer link to the source code (empty = hide)
SOURCE_URL=https://github.com/jbzambon/flightlog
# Pre-fills From/To when adding a flight
HOME_AIRPORT=
# OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# Google accounts allowed to add/edit/delete (comma-separated)
ALLOWED_EMAILS=you@example.com
# Long random string: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fields hidden from signed-out visitors (empty = show everything)
PUBLIC_HIDDEN_FIELDS=instructor,notes
# Your domain, used by the bundled Caddy config
DOMAIN=flightlog.example.com
